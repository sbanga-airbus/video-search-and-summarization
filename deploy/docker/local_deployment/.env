export NGC_API_KEY=<user-ngc-api-key>  # api key to pull model from NGC. Add this if you are not using the jupyter notebooks
export NVIDIA_API_KEY=random-placeholder-key  # need a random string here to avoid bug in endpoint client library; actual key not needed as the endpoint is local
export HF_TOKEN=<user-hf-token>
export TRANSFORMERS_CACHE_DIR=/mnt/data1/ml_dev/llm/transformers_cache
export LOCAL_NIM_CACHE=~/.cache/nim

#Use latest public image 2.4.1.
export VIA_IMAGE=nvcr.io/nvidia/blueprint/vss-engine:2.4.1

#Adjust ports if needed
export FRONTEND_PORT=9101
export BACKEND_PORT=8100

#Change default user and pass if needed
export GRAPH_DB_USERNAME=neo4j
export GRAPH_DB_PASSWORD=password
export ARANGO_DB_USERNAME=root
export ARANGO_DB_PASSWORD=password

#Update paths local paths to config files if needed 
export CA_RAG_CONFIG=./config.yaml
export GUARDRAILS_CONFIG=./guardrails

#Set VLM to Cosmos-Reason2
export VLM_MODEL_TO_USE=cosmos-reason2
export MODEL_PATH=git:https://huggingface.co/nvidia/Cosmos-Reason2-8B
# Increase this in case of larger models
export VLLM_GPU_MEMORY_UTILIZATION=0.35 # 0.35 set for H200, default 0.4 for H100
# export VLM_MAX_MODEL_LEN=20480

#Adjust misc configs if needed
export DISABLE_GUARDRAILS=false

export NVIDIA_VISIBLE_DEVICES=0 #For H100 Deployment
#export NVIDIA_VISIBLE_DEVICES=0,1,2 #For L40S Deployment

export ENABLE_AUDIO=false
export RIVA_ASR_SERVER_URI=host.docker.internal
export RIVA_ASR_GRPC_PORT=50051
export RIVA_ASR_HTTP_PORT=9000
export MINIO_PORT=9002
export MINIO_WEBUI_PORT=9003
export RIVA_ASR_SERVER_IS_NIM=true
export ENABLE_RIVA_SERVER_READINESS_CHECK=true

export DISABLE_CV_PIPELINE=true
export INSTALL_PROPRIETARY_CODECS=false # Set to true when enabling CV
